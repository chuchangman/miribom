[Unit]
Description=Miribom FastAPI AI server
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/miribom/AI
EnvironmentFile=/opt/miribom/AI/.env
ExecStart=/opt/miribom/AI/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
