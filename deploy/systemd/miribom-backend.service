[Unit]
Description=Miribom Django backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/miribom/backend
EnvironmentFile=/opt/miribom/backend/.env
ExecStart=/opt/miribom/backend/venv/bin/gunicorn miribom.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
